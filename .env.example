# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────
# SQLite file. Point this at a persistent volume in production.
DATABASE_PATH=./data/salon-studio.db

# ── Security ──────────────────────────────────────────────────────────────
# Use a long random string in production. If unset, a secret is generated once
# and persisted to data/.jwt-secret (fine for local development only).
JWT_SECRET=

# Comma-separated emails auto-promoted to super admin (full platform access).
# Promotion only happens after Google verifies the address; password-only
# installs should use `npm run make-admin -- you@example.com` instead.
# Example: ADMIN_EMAILS=you@yoursalon.com
ADMIN_EMAILS=

# ── Google Sign-In (optional but recommended) ─────────────────────────────
# Create an OAuth 2.0 Web client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <PUBLIC_SITE_ORIGIN>/api/auth/google/callback
# Leave both blank to hide the Google button; email + password keeps working.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only set this if the public origin differs from the origin users sign in on.
# GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback

# ── Public addressing ─────────────────────────────────────────────────────
# Your platform's own domain, used for search previews and share links.
# Example: PUBLIC_SITE_ORIGIN=https://velvetstudio.com
PUBLIC_SITE_ORIGIN=

# Optional wildcard domain. When set, <slug>.PUBLIC_BASE_DOMAIN serves each
# salon automatically (requires a wildcard DNS record).
# Example: PUBLIC_BASE_DOMAIN=velvetstudio.com
PUBLIC_BASE_DOMAIN=

# Defaults for a new install; the super admin can change name, support email,
# announcement and access rules from Admin → Settings at runtime.
PLATFORM_NAME="Velvet Salon Studio"
SUPPORT_EMAIL=hello@velvetstudio.app
MAX_UPLOAD_MB=6

# ── Email (optional) ──────────────────────────────────────────────────────
# Without these, booking and review notifications are logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Velvet Salon Studio <hello@example.com>"
